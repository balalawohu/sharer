# 服务端口
PORT=3000

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sharer

# JWT
JWT_SECRET=

# 存储驱动：local（本地磁盘） | qiniu（七牛云对象存储）
STORAGE_DRIVER=local

# 七牛云配置（STORAGE_DRIVER=qiniu 时必填）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_UPLOAD_TOKEN_EXPIRES=3600
